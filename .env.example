# ==============================================================================
# MUMBAI LOCAL OFFLINE TIMETABLE APPLICATION - ENVIRONMENT CONFIGURATION
# ==============================================================================
# CRITICAL SECURITY RULE:
# NEVER commit private credentials, API keys, service-account JSON, or database passwords
# into git repository or client-side application assets.
# ==============================================================================

# --- OFFICIAL RAILWAY DATA SOURCES ---
OFFICIAL_WR_URL=https://wr.indianrailways.gov.in/view_section.jsp?fontColor=black&backgroundColor=LIGHTSTEELBLUE&lang=0&id=0,6,458
OFFICIAL_CR_URL=https://cr.indianrailways.gov.in/view_section.jsp?fontColor=black&backgroundColor=LIGHTSTEELBLUE&lang=0&id=0,5,2360
SYNC_INTERVAL_HOURS=6

# --- STORAGE PROVIDER CONFIGURATION ---
# Supported providers: 'local' (development mock), 'google_drive', 's3' (future migration)
STORAGE_PROVIDER=local

# Local Storage (used when STORAGE_PROVIDER=local)
LOCAL_STORAGE_BASE_PATH=./storage/google-drive-mock

# Google Drive Storage (used when STORAGE_PROVIDER=google_drive)
# Server-side only! Never expose to client applications or Android APK!
GOOGLE_DRIVE_REPOSITORY_ID=your-google-drive-folder-id
GOOGLE_DRIVE_BASE_FOLDER=MumbaiLocalTimetable
GOOGLE_DRIVE_DATA_PATH=current
GOOGLE_DRIVE_UPDATES_PATH=updates
GOOGLE_DRIVE_BACKUPS_PATH=backups
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...==\n-----END PRIVATE KEY-----\n"

# --- CANONICAL DATABASE CONFIGURATION ---
# Path to canonical SQLite database on backend
CANONICAL_DATABASE_PATH=./data/canonical.sqlite

# --- ADMIN DASHBOARD & SECURITY ---
ADMIN_AUTH_SECRET=replace-with-a-random-32-byte-hex-secret-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-argon2-or-bcrypt-hash

# --- SERVER / API CONFIGURATION ---
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Mumbai Local Railway Timetable"
