{
  "version": 2,
  "crons": [
    {
      "path": "/api/sync/cron",
      "schedule": "0 */6 * * *"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/mobile", "dest": "/apps/web-admin/public/mobile.html" },
    { "src": "/(.*)", "dest": "/apps/web-admin/public/$1" }
  ]
}
