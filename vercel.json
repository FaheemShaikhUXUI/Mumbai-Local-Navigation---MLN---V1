{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/**": {
      "includeFiles": "storage/**"
    }
  },
  "crons": [
    {
      "path": "/api/sync/cron",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    { "source": "/mobile", "destination": "/mobile.html" }
  ]
}
